# Copy to .env (local) or add in your hosting dashboard. All are required unless marked optional.
# Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
# https://www.weatherapi.com (free plan is enough)
VITE_WEATHERAPI_KEY=
# Optional: improves reading of photographed soil reports. https://ocr.space/ocrapi
VITE_OCR_SPACE_API_KEY=

# NOT here: GROQ_API_KEY (and optional GROQ_MODEL) are Supabase function secrets:
#   supabase secrets set GROQ_API_KEY=...
